# LLMScope Environment Configuration

# API Settings
API_TITLE=LLMScope API
API_VERSION=1.0.0

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/llmscope

# Redis
REDIS_URL=redis://localhost:6379
REDIS_QUEUE_NAME=llmscope:events
REDIS_QUEUE_BATCH_SIZE=100
REDIS_DLQ_NAME=llmscope:events:dlq

# Worker Settings
WORKER_POLL_INTERVAL=0.1
WORKER_MAX_RETRIES=3
WORKER_RETRY_BACKOFF_BASE=2.0

# Security
SECRET_KEY=change-me-in-production
API_KEY_HEADER=X-API-Key

# Single-Tenant Mode (set to false for multi-tenant)
SINGLE_TENANT_MODE=true
REQUIRE_AUTH=true
API_KEY=llmscope-local-key

# Default tenant/project IDs (used in single-tenant mode)
DEFAULT_TENANT_ID=default
DEFAULT_PROJECT_ID=main

# Rate Limiting
RATE_LIMIT_REQUESTS=1000
RATE_LIMIT_PERIOD=60

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Monitoring
ENABLE_METRICS=true
METRICS_PORT=9090

# Workers
ENABLE_WORKERS=true
WORKER_CONCURRENCY=4

# Anthropic API Key (required for /demo and /api/v1/chat endpoints)
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# ============================================
# Docker Deployment - Playground Application
# ============================================

# Playground Database Configuration
PLAYGROUND_DATABASE_URL=postgresql://postgres:postgres@postgres:5432/llmscope

# Playground Redis Configuration
PLAYGROUND_REDIS_URL=redis://redis:6379

# Playground Session Configuration
PLAYGROUND_SESSION_TTL_DAYS=7
PLAYGROUND_SESSION_CLEANUP_INTERVAL_HOURS=24

# Playground Security
# Generate a secure secret key using: openssl rand -hex 32
PLAYGROUND_SECRET_KEY=your-secret-key-here

# Playground CORS (comma-separated origins)
PLAYGROUND_CORS_ORIGINS=http://localhost:3000,http://localhost:8001

# AI Provider
# Get your API key from: https://console.anthropic.com/
PLAYGROUND_ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Playground Rate Limiting
PLAYGROUND_RATE_LIMIT_REQUESTS_PER_SESSION=100
PLAYGROUND_RATE_LIMIT_PERIOD_SECONDS=60
